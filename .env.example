# Copy this file to ".env" and fill in the values you need.

# Telegram bot token from @BotFather (required for `python main.py bot`)
TELEGRAM_BOT_TOKEN=

# Free API key from https://developer.pubg.com (required for PUBG lookups)
PUBG_API_KEY=

# Optional paid HIBP API key — enables breach-account lookups for e-mails
HIBP_API_KEY=
